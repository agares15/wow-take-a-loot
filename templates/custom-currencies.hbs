<div class="wow-looter-window custom-currencies-window">
  <header class="looter-header settings-header">
    <div class="header-main">
      <h2><i class="fas fa-coins"></i> {{localize "WOW_LOOTER.CustomCurrencies.Title"}}</h2>
    </div>
    <p class="subtitle">{{localize "WOW_LOOTER.CustomCurrencies.Subtitle"}}</p>
  </header>

  <div class="currency-drop-zone drop-target">
    <i class="fas fa-hand-holding-dollar fa-2x"></i>
    <p class="drop-text">{{localize "WOW_LOOTER.CustomCurrencies.DropHint"}}</p>
  </div>

  <div class="custom-currencies-list-container">
    <h3>{{localize "WOW_LOOTER.CustomCurrencies.RegisteredList"}}</h3>
    <p class="custom-currency-abbr-hint">{{localize "WOW_LOOTER.CustomCurrencies.AbbrHint"}}</p>
    <ul class="custom-currencies-list">
      {{#each customCurrencies}}
      <li class="custom-currency-row" data-index="{{@index}}">
        <img src="{{this.img}}" alt="{{this.name}}" class="custom-currency-thumb" />
        <div class="custom-currency-info">
          <span class="custom-currency-name">{{this.name}}</span>
          <span class="custom-currency-key"><code>{{this.key}}</code></span>
        </div>
        <div class="custom-currency-abbr-field">
          <label class="custom-currency-abbr-label">{{localize "WOW_LOOTER.CustomCurrencies.AbbrLabel"}}</label>
          <input type="text" class="custom-currency-abbr-input" maxlength="4" value="{{this.abbr}}" placeholder="{{localize 'WOW_LOOTER.CustomCurrencies.AbbrPlaceholder'}}" data-index="{{@index}}" title="{{localize 'WOW_LOOTER.CustomCurrencies.AbbrHint'}}" />
        </div>
        <button type="button" class="btn-icon danger btn-delete-currency" data-action="remove-currency" data-index="{{@index}}" title="{{localize 'WOW_LOOTER.Common.Delete'}}">
          <i class="fas fa-trash"></i>
        </button>
      </li>
      {{else}}
      <li class="empty-state">
        <p>{{localize "WOW_LOOTER.CustomCurrencies.Empty"}}</p>
      </li>
      {{/each}}
    </ul>
  </div>

  <footer class="looter-footer">
    <button type="button" class="btn btn-secondary" data-action="close">
      <i class="fas fa-times"></i> {{localize "WOW_LOOTER.Common.Close"}}
    </button>
  </footer>
</div>

