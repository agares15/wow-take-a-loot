<div class="wow-looter-window manual-loot-window">
  <header class="looter-header">
    <div class="target-profile-container">
      <div class="target-profile">
        <span class="target-avatar-wrap" style="width: 46px; height: 46px; flex-shrink: 0;">
          <img src="{{targetImg}}" alt="{{targetName}}" class="target-avatar-img" width="46" height="46" data-scale-x="{{targetScaleX}}" data-scale-y="{{targetScaleY}}" style="width: 46px; height: 46px; object-fit: contain; transform: scale({{targetScaleX}}, {{targetScaleY}});" />
        </span>
        <div class="target-info">
          <h2>{{targetName}}</h2>
          <span class="badge lootable-badge">
            <i class="fas {{#if isLootActor}}fa-box-open{{else}}fa-skull{{/if}}"></i>
            {{#if isLootActor}}{{localize "WOW_LOOTER.Manual.BadgeLoot"}}{{else}}{{localize
            "WOW_LOOTER.Manual.BadgeBody"}}{{/if}}
          </span>
        </div>
      </div>
      <div class="header-action-buttons">
        {{#if isGM}}
        <button type="button" class="btn-icon header-gear-btn" data-action="open-loot-settings"
          title="{{localize 'WOW_LOOTER.Manual.LootSettings'}}">
          <i class="fas fa-cog"></i>
        </button>
        {{/if}}
      </div>
    </div>

    <!-- Descripción personalizada del botín/contenedor si está configurada -->
    {{#if customDescription}}
    <div class="custom-loot-description">
      <i class="fas fa-scroll"></i>
      <div class="custom-desc-text">{{{customDescription}}}</div>
    </div>
    {{/if}}

    <!-- Indicador y selector del personaje que recibe el botín -->
    <div class="recipient-row">
      <span class="recipient-label"><i class="fas fa-hand"></i> {{localize "WOW_LOOTER.Manual.LootingAs"}}:</span>
      {{#if (gt looterOptions.length 1)}}
      <select class="looter-select">
        {{#each looterOptions}}
        <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
        {{/each}}
      </select>
      {{else}}
      <strong class="recipient-name">{{lootingActorName}}</strong>
      {{/if}}
    </div>
  </header>

  <!-- Panel de Monedas -->
  {{#if hasCurrencies}}
  <section class="looter-box currency-manual-box">
    <div class="box-header">
      <h3><i class="fas fa-coins"></i> {{localize "WOW_LOOTER.Manual.Money"}}</h3>
    </div>

    <div class="manual-currency-content">
      <div class="currency-pills-row">
        {{#each currenciesList}}
        <div class="currency-pill {{this.key}} {{#if ../isGM}}editable{{/if}}">
          <img src="{{this.img}}" alt="{{this.label}}" class="currency-coin-icon" />
          {{#if ../isGM}}
            <input type="number" class="coin-input num-box" data-currency="{{this.key}}" value="{{this.value}}" min="0" title="{{localize 'WOW_LOOTER.GM.EditCurrency'}}" />
          {{else}}
            <span class="coin-qty-label">{{this.value}}</span>
          {{/if}}
          <span class="currency-denom-label">{{this.label}}</span>
        </div>
        {{/each}}
      </div>

      <!-- Fila 1: Cantidad + Selector de Moneda + Botón Take Amount -->
      <div class="take-currency-row">
        <input type="number" class="manual-money-input" value="{{takeAmountInput}}" min="1" placeholder="0"
          data-action="edit-take-amount" />
        <select class="manual-currency-select" title="{{localize 'WOW_LOOTER.Manual.CurrencyType'}}">
          {{#each currenciesList}}
          <option value="{{this.key}}">{{this.label}}</option>
          {{/each}}
        </select>
        <button type="button" class="btn btn-secondary btn-take-amount" data-action="take-specific-currency">
          <i class="fas fa-hand-holding-dollar"></i> {{localize "WOW_LOOTER.Manual.TakeMoney"}}
        </button>
        <button type="button" class="btn btn-secondary btn-take-all" data-action="take-all-currency">
          <i class="fas fa-sack-dollar"></i> {{localize "WOW_LOOTER.Manual.TakeAllMoney"}}
        </button>
        <button type="button" class="btn btn-primary btn-split-party" data-action="split-currency-party">
          <i class="fas fa-users"></i> {{localize "WOW_LOOTER.Manual.SplitWithParty"}}
        </button>
      </div>

  </section>
  {{/if}}

  <!-- Lista de Items Simplificada (Soporta arrastrar y soltar items sobre la ventana) -->
  <section class="looter-box items-manual-box">
    <div class="box-header">
      <h3><i class="fas fa-treasure-chest"></i> {{localize "WOW_LOOTER.Manual.ItemsInLoot"}}</h3>
      <span class="badge items-count-badge">{{items.length}}</span>
    </div>

    <ul class="manual-loot-list">
      {{#each items}}
      <li class="manual-item-row" data-item-id="{{this.id}}">
        <div class="manual-item-main">
          <img src="{{this.img}}" alt="{{this.name}}" class="item-img" data-action="toggle-item-desc" />
          <div class="item-details" data-action="toggle-item-desc">
            <span class="item-name">{{this.name}}</span>
            {{#if (gt this.quantity 1)}}
            <span class="item-qty-badge">x{{this.quantity}}</span>
            {{/if}}
            <i class="fas fa-chevron-down toggle-desc-icon"></i>
          </div>
          <div class="item-actions">
            {{#if (gt this.quantity 1)}}
            <input type="number" class="item-take-qty-input num-box" min="1" max="{{this.quantity}}" value="1"
              title="{{localize 'WOW_LOOTER.Manual.QuantityToTake'}}" />
            {{/if}}
            <div class="item-bulk-badge" title="{{localize 'WOW_LOOTER.Merchant.Bulk'}}">
              <i class="fas fa-weight-hanging"></i>
              <span>{{this.bulk}}</span>
            </div>
            <button type="button" class="btn btn-secondary btn-sm btn-item-loot" data-action="take-item"
              data-item-id="{{this.id}}" title="{{localize 'WOW_LOOTER.Manual.LootItem'}}">
              {{localize "WOW_LOOTER.Manual.LootItem"}}
            </button>
          </div>
        </div>
        <div class="item-description-drawer" style="display: none;">
          {{#if this.description}}
          <div class="item-desc-content">{{{this.description}}}</div>
          {{else}}
          <p class="no-desc">{{localize "WOW_LOOTER.Common.NoDescription"}}</p>
          {{/if}}
        </div>
      </li>
      {{else}}
      <li class="empty-state">
        <i class="fas fa-ghost"></i>
        <p>{{localize "WOW_LOOTER.Manual.EmptyBody"}}</p>
      </li>
      {{/each}}
    </ul>
  </section>

  <footer class="looter-footer">
    <button type="button" class="btn btn-secondary btn-footer-close" data-action="close">
      <i class="fas fa-times"></i> {{localize "WOW_LOOTER.Common.Close"}}
    </button>
    {{#if (gt items.length 0)}}
    <button type="button" class="btn btn-primary btn-footer-loot-all" data-action="loot-all-items">
      <i class="fas fa-box-open"></i> {{localize "WOW_LOOTER.Manual.LootAll"}}
    </button>
    {{/if}}
  </footer>
</div>